PORT=3001
AWS_REGION=us-east-1
CORS_ORIGIN=http://localhost:5173

# Primary: Amazon Nova Pro (no Anthropic approval needed)
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0

# Alternative if Anthropic use-case approved:
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Tool configuration — real AWS resources (no mock)
CLOUDWATCH_LOG_GROUP=/devops/incident-demo
SNS_ESCALATION_TOPIC_ARN=arn:aws:sns:us-east-1:YOUR_ACCOUNT_ID:devops-incident-escalation
ECS_CLUSTER_NAME=
ECS_SERVICE_NAME=
